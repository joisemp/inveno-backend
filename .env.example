# ─────────────────────────────────────────────────────────────────────────────
# Inveno API — Environment Variables
# Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=your-very-secret-key-change-me-in-production
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (local Docker) ───────────────────────────────────────────────────
POSTGRES_DB=inveno
POSTGRES_USER=inveno
POSTGRES_PASSWORD=inveno
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Database (production — Railway injects this; do not set POSTGRES_* ) ──────
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: SameSite for the httpOnly refresh cookie (inveno_refresh).
# Lax (default) works for localhost and same-site subdomains (app + api).
# Use None only for a true cross-site SPA; requires HTTPS (Secure cookies).
# REFRESH_COOKIE_SAMESITE=Lax

# ── Email (dev: uses console backend — no config needed) ──────────────────────
DEFAULT_FROM_EMAIL=noreply@inveno.app

# ── Email (prod: fill these in for production SMTP) ───────────────────────────
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# ── DigitalOcean Spaces (production only) ─────────────────────────────────────
# DO_SPACES_KEY=your-spaces-access-key
# DO_SPACES_SECRET=your-spaces-secret-key
# DO_SPACES_BUCKET=inveno-static
# DO_SPACES_REGION=nyc3
# DO_SPACES_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com
# DO_SPACES_STATIC_PREFIX=static/
# DO_SPACES_MEDIA_PREFIX=media/
# DO_SPACES_CUSTOM_DOMAIN=cdn.yourdomain.com

# ── Frontend URL (used in welcome-email get-started link) ─────────────────────
FRONTEND_URL=http://localhost:5173

# ── Purchase-flow process trail (server-only) ────────────────────────────────
# HMAC-SHA256 key for ProcessEvent records (submit, approve, quote, QC, stock-in).
# Used by POST /api/orgs/process-events/verify/ and the hash printed on PDF/Excel.
# This is not a user/vendor signature and must not be sent to the frontend.
# Do not reuse DJANGO_SECRET_KEY. Rotating this key invalidates old trail signatures.
# Production: python -c "import secrets; print(secrets.token_hex(32))"
PROCESS_SIGNING_KEY=change-me-process-signing-key

# ── Sentry (optional) ────────────────────────────────────────────────────────
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
