# ─────────────────────────────────────────────────────────────────────────────
# Inveno API — Frontend Developer Environment File
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.api in your React project root.
# Used with: docker-compose.frontend-dev.yml
# ─────────────────────────────────────────────────────────────────────────────

DJANGO_SECRET_KEY=frontend-dev-secret-not-for-production
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# HMAC-SHA256 key for purchase-flow ProcessEvent records (trail verify / PDF hash).
# Server-only — not a user/vendor signature. Do not reuse DJANGO_SECRET_KEY.
# Rotating this key invalidates old trail signatures.
# Production: python -c "import secrets; print(secrets.token_hex(32))"
PROCESS_SIGNING_KEY=change-me-process-signing-key

POSTGRES_DB=inveno
POSTGRES_USER=inveno
POSTGRES_PASSWORD=inveno
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: SameSite for the httpOnly refresh cookie. Lax is the default.
# REFRESH_COOKIE_SAMESITE=Lax

DEFAULT_FROM_EMAIL=noreply@inveno.app

FRONTEND_URL=http://localhost:5173

# After migrate the API seeds a demo org (see FRONTEND_API.md Quick Start).
# Use attached `docker compose up` (not -d) to type [k] keep / [w] wipe.
# Wipe later: docker compose exec -it api python manage.py seed_demo --reset
SEED_DEMO=true

# Optional dedicated HMAC key for JWTs. If unset, DJANGO_SECRET_KEY is used.
# JWT_SIGNING_KEY=
